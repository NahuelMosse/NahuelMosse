  "breaking": {
    "profiles": "the kit is a base plus profiles (web, backend, flutter): `kit.mjs profile on|off <p>` and `install.mjs --profiles`; probe, motion-curves, attack, the designer and design-refs.md come with their profile, and a card whose lens needs a profile that is off lists it in `lensesOff`",
    "card": "specs/<card>/card.md is the single document (L1, Specs, Tasks, Gate, Log); card.snapshot.md, plan.md and the nine steps are gone",
    "agents": "builder and judge replace implementer, conductor, inspector and reviewer; review follows risk.json",
    "commands": "/scenarios and /validate are gone: /card, then build, the gate (verify.mjs), the plan judge at high, /close"
  },
  "grades": {
    "order": ["poc", "mvp", "production"],
    "default": "production",
    "levels": {
      "poc": {
        "does": "a facade to show how it would look: presentation with mock data, one capture round, no tests",
        "goalTimes": 1, "capTimes": 2, "mutation": "none", "without": ["judge"],
        "testsFrozen": false, "designRounds": 1
      },
      "mvp": {
        "does": "a first real use: basic security, AA where it touches, the judge, the API documented, mutation of the domain",
        "goalTimes": 4, "capTimes": 8, "mutation": "domain", "without": []
      },
      "production": {
        "does": "the whole bar",
        "goalTimes": 5, "capTimes": 10, "mutation": "all", "without": []
      }
    }
  },
